{
  "info": {
    "name": "Student Grading System",
    "description": "JWT auth. Login first, then use the token. Username is the student identifier.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "studentId", "value": "1" },
    { "key": "courseId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List / search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/students?name=Aykhan&username=&groupId="
          }
        },
        {
          "name": "Transcript",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/students/{{studentId}}/transcript"
          }
        }
      ]
    },
    {
      "name": "Class schedules",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"startTime\": \"09:00:00\",\n  \"endTime\": \"10:30:00\",\n  \"room\": \"A-101\",\n  \"courseOfferingId\": 1\n}"
            },
            "url": "{{baseUrl}}/class-schedules"
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/class-schedules?courseOfferingId=1"
          }
        }
      ]
    },
    {
      "name": "Grades",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 85,\n  \"type\": \"FINAL\",\n  \"enrollmentId\": 1\n}"
            },
            "url": "{{baseUrl}}/grades"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Course average",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reports/courses/{{courseId}}/average-score"
          }
        },
        {
          "name": "Top students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reports/courses/{{courseId}}/top-students"
          }
        },
        {
          "name": "Student average",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reports/students/{{studentId}}/average-score"
          }
        }
      ]
    }
  ]
}
